{
  "manifestVersion": 2,
  "id": "shiguangji-app",
  "name": "拾光记",
  "version": "0.0.49",
  "entry": "index.js",
  "description": "把和伙伴聊过的一天整理成日记，让伙伴到点提醒待办。还能记心情、纪念日，给聊天带上当天的日期与天气和特殊节假日问候。",
  "icon": "assets/icon.png",
  "contributes": {
    "cards": [
      {
        "id": "calendar",
        "title": "拾光记",
        "description": "把和伙伴聊过的一天整理成日记：待办到点提醒、记心情与纪念日，给聊天带上当天的日期、天气和节日问候",
        "route": "/panel.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "functionPanel": { "id": "hall", "label": "拾光记", "route": "/hall.html" },
        "face": { "image": "assets/panel-cover.png" },
        "pageIcon": "assets/page-icon.png"
      }
    ]
  },
  "capabilities": [
    "app/hooks.agent-before-start",
    "app/hooks.messages-post-assistant",
    "app/models.read",
    "app/models.infer",
    "app/agents.read",
    "app/resources.read",
    "app/sessions.read",
    "app/notifications.show",
    "app/tools.expose-to-model",
    "app/services.provide",
    "app/public-data.publish",
    "app/tasks.manage"
  ],
  "minAppVersion": "0.1059.0",
  "network": {
    "allowedHosts": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com",
      "api.deepseek.com",
      "api.openai.com",
      "api.anthropic.com",
      "openrouter.ai",
      "api.moonshot.cn",
      "open.bigmodel.cn",
      "dashscope.aliyuncs.com",
      "ark.cn-beijing.volces.com",
      "api.siliconflow.cn",
      "api.z.ai",
      "api.minimax.chat",
      "api.minimaxi.com",
      "api.x.ai",
      "api.groq.com",
      "api.mistral.ai"
    ],
    "methods": ["GET", "POST"],
    "defaultTimeoutMs": 30000,
    "maxResponseBytes": 1048576
  }
}
