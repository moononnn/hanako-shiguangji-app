{
  "manifestVersion": 2,
  "id": "shiguangji-app",
  "name": "拾光记",
  "version": "0.2.5",
  "entry": "index.js",
  "description": "让伙伴自然知道当下的时间，带上当天的天气和节日问候；把和伙伴聊过的一天整理成日记：待办到点提醒，记心情和纪念日；装了茶话会，还能约一位伙伴陪你安静做完一段事，有点像《放松时光：与你共享Lo-Fi故事》那种有人陪着的感觉。用 DeepSeek 模型时，会在费用更高的时段自然提醒你一句。",
  "icon": "assets/icon.png",
  "contributes": {
    "cards": [
      {
        "id": "calendar",
        "title": "拾光记",
        "description": "让伙伴自然知道当下的时间，带上当天的天气和节日问候；把和伙伴聊过的一天整理成日记：待办到点提醒，记心情和纪念日；装了茶话会，还能约一位伙伴陪你安静做完一段事，有点像《放松时光：与你共享Lo-Fi故事》那种有人陪着的感觉。用 DeepSeek 模型时，会在费用更高的时段自然提醒你一句。",
        "route": "/panel.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "functionPanel": { "id": "hall", "label": "拾光记", "route": "/hall.html" },
        "face": { "image": "assets/panel-cover.png" },
        "pageIcon": "assets/page-icon.svg"
      }
    ]
  },
  "capabilities": [
    "app/hooks.agent-before-start",
    "app/hooks.agent-pre-step",
    "app/hooks.messages-post-assistant",
    "app/models.read",
    "app/models.infer",
    "app/agents.read",
    "app/process.spawn",
    "app/resources.read",
    "app/sessions.read",
    "app/notifications.show",
    "app/tools.expose-to-model",
    "app/services.provide",
    "app/services.call",
    "app/public-data.publish",
    "app/tasks.manage"
  ],
  "minAppVersion": "0.1059.0",
  "network": {
    "allowedHosts": [
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com",
      "api.deepseek.com",
      "api.openai.com",
      "api.anthropic.com",
      "openrouter.ai",
      "api.moonshot.cn",
      "open.bigmodel.cn",
      "dashscope.aliyuncs.com",
      "ark.cn-beijing.volces.com",
      "api.siliconflow.cn",
      "api.z.ai",
      "api.minimax.chat",
      "api.minimaxi.com",
      "api.x.ai",
      "api.groq.com",
      "api.mistral.ai"
    ],
    "methods": ["GET", "POST"],
    "defaultTimeoutMs": 30000,
    "maxResponseBytes": 1048576
  }
}
