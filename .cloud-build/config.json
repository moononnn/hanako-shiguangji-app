{
  "schema": 1,
  "project": {
    "id": "shiguangji-app",
    "name": "拾光记",
    "kind": "app",
    "version": "0.2.6",
    "repoUrl": "moononnn/hanako-shiguangji-app"
  },
  "publisher": "moononnn & 小花",
  "source": {
    "roots": [
      "."
    ]
  },
  "checks": {
    "testCommands": [],
    "deferredTo": "existing-ci + local precise verify"
  },
  "package": {
    "topLevel": "shiguangji-app",
    "entry": "index.js",
    "include": [],
    "excludeDirs": [
      "tests",
      "node_modules",
      ".git",
      "_backups",
      ".github",
      "attachments",
      ".cloud-build",
      ".cache",
      "out"
    ],
    "excludeFiles": [
      "PENDING_CHANGES.md",
      "PUBLISHING.md",
      "PROJECT_LOG.md",
      "TESTING.md",
      "data.json",
      "preferences.json",
      "probe-result.json",
      ".installed-by.json",
      ".gitignore",
      ".gitattributes"
    ],
    "excludeGlobs": [
      "DESIGN-*.md",
      "PLAN-*.md",
      "*.log",
      "*.tmp",
      "tmp-*",
      "*.dat",
      "*.corrupt-*",
      ".corrupt-*",
      "analysis-*.json",
      "taste-*.json"
    ]
  },
  "devOnly": {
    "targets": [
      "routes/ui.js"
    ],
    "startMark": "// __shiguangji-app_DEV_ONLY__",
    "endMark": "// __shiguangji-app_DEV_ONLY_END__",
    "residue": [
      "/api/xingji/debug-sample",
      "xingji-debug-sample"
    ],
    "replacements": []
  },
  "privacy": {
    "redlineSource": "local-only（云端不持有词表；本机用 projects/<id>.json 的 redline 扫）",
    "textExtensions": [
      ".js",
      ".mjs",
      ".cjs",
      ".json",
      ".md",
      ".html",
      ".css",
      ".txt",
      ".yml",
      ".yaml",
      ".ps1"
    ],
    "allowedNames": [
      "小花",
      "moononnn",
      "Hanako",
      "Moonon"
    ]
  },
  "resources": {
    "manifestFile": "manifest.json",
    "bases": [
      "",
      "ui/"
    ],
    "pointers": [
      "icon",
      "contributes.cards[].face.image",
      "contributes.cards[].pageIcon",
      "contributes.cards[].route"
    ]
  },
  "output": {
    "archiveBaseName": "app-shiguangji-app-{version}",
    "zipExtension": ".zip"
  },
  "toolchain": {
    "packScript": "scripts/extension-pack.mjs",
    "pin": {
      "channel": "beta",
      "channelManifest": "https://dl.openhanako.com/channels/beta.json",
      "version": "1.3.6-beta",
      "platform": "win32-x64",
      "file": "server-1.3.6-beta-win32-x64.tar.gz",
      "sha256": "274c3deb9723ac345d7756c366914466da406bde8ea44f09258fcc85ed82a3b6",
      "size": 264266684,
      "mirrors": [
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-42",
        "https://dl.openhanako.com",
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-41",
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-40"
      ]
    }
  }
}
